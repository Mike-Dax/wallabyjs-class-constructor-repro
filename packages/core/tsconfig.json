{
  "compilerOptions": {
    "module": "ESNext",
    "esModuleInterop": true,
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "noImplicitAny": true,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "exactOptionalPropertyTypes": false,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "./lib",
    "paths": {
      "*": [
        "node_modules/*",
        "src/types/*"
      ]
    }
  },
  "include": [
    "./src/**/*",
    "./test/**/*",
    "index.ts"
  ]
}