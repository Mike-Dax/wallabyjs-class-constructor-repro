{
  "name": "@electricui/async-utilities",
  "version": "0.9.6",
  "description": "ElectricUI Async Utilities",
  "electricui-dev": true,
  "author": "Electric UI <support@electricui.com> (https://electricui.com)",
  "license": "SEE LICENCE IN LICENCE",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "publishConfig": {
    "main": "lib/cjs/index.eui.js",
    "module": "lib/esm/index.eui.js"
  },
  "sideEffects": false,
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/**/*",
    "manifest.json"
  ],
  "dependencies": {
    "@electricui/timing": "workspace:*",
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-runtime": "7.25.9",
    "@electricui/build-rollup-config": "workspace:*",
    "@eslint/js": "9.33.0",
    "@types/debug": "^4.1.1",
    "@types/node": "22.9.0",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "rollup": "4.50.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "prepack": "silversmith prepack",
    "build": "rm -rf ./lib && rollup -c --bundleConfigAsCjs",
    "postpack": "silversmith postpack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:inspect": "node --inspect-brk $(yarn bin vitest --no-file-parallelism --test-timeout=0)",
    "test:coverage": "vitest run --coverage"
  }
}
