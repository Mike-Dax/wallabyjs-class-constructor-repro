{
  "compilerOptions": {
    "module": "ESNext",
    "esModuleInterop": true,
    "target": "esnext",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "./lib",
    "jsx": "react-jsx"
  },
  "include": ["./src/**/*", "index.ts", "./benchmark/**/*"]
}
